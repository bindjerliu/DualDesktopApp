<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.omel.controller.UserController" styleClass="app-bg">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" styleClass="topbar">
            <padding><Insets top="18" right="28" bottom="18" left="28"/></padding>
            <VBox spacing="2">
                <Label text="OMEL" styleClass="nav-brand"/>
                <Label text="RIT Kosovo Campus Café" styleClass="muted-text"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <TextField fx:id="searchField" promptText="Search menu, category, dietary info..." prefWidth="360" styleClass="search-input"/>
            <Button text="Back" onAction="#back" styleClass="ghost-button"/>
        </HBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="transparent-scroll">
            <FlowPane fx:id="menuGrid" hgap="18" vgap="18" prefWrapLength="780">
                <padding><Insets top="28" right="28" bottom="28" left="28"/></padding>
            </FlowPane>
        </ScrollPane>
    </center>
    <right>
        <VBox spacing="16" prefWidth="370" styleClass="cart-panel">
            <padding><Insets top="28" right="28" bottom="28" left="28"/></padding>
            <Label text="Your Order" styleClass="section-title"/>
            <ListView fx:id="cartList" prefHeight="210" styleClass="premium-list"/>
            <HBox spacing="10">
                <Button text="Remove" onAction="#removeSelected" styleClass="secondary-button" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <Button text="Clear" onAction="#clearCart" styleClass="ghost-button" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            </HBox>
            <Separator/>
            <TextField fx:id="nameField" promptText="Full name" styleClass="premium-input"/>
            <TextField fx:id="emailField" promptText="Student email" styleClass="premium-input"/>
            <ComboBox fx:id="pickupCombo" maxWidth="Infinity" styleClass="premium-input"/>
            <TextArea fx:id="notesArea" promptText="Notes, allergies, custom request..." prefRowCount="3" wrapText="true" styleClass="premium-input"/>
            <HBox alignment="CENTER_LEFT">
                <Label text="Total" styleClass="body-large"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="totalLabel" text="€0.00" styleClass="total-label"/>
            </HBox>
            <Button text="Place Order" onAction="#placeOrder" maxWidth="Infinity" styleClass="primary-button-large"/>
            <Label fx:id="statusLabel" text="Choose your items and pickup time." wrapText="true" styleClass="success-text"/>
        </VBox>
    </right>
</BorderPane>
